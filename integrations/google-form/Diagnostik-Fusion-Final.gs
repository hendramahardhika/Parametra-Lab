/**
 * Diagnostik final Parametra Lab - versi kuis 1.2, 29 Oktober 2026.
 * Salin SELURUH file ini ke Code.gs di proyek Apps Script baru.
 * Jalankan buatDiagnostikFusionFinal. Tidak memerlukan URL /exec atau file gambar di Drive.
 * Membuat form BARU sebagai draf. Tidak menyunting form diagnostik/angket terdahulu.
 * 12 PG: kunci kuis dan 1 poin otomatis. C1-C2: masing-masing 3 poin manual.
 * Sebelum publikasi, atur Rilis nilai: Nanti, setelah peninjauan manual di editor Forms.
 * Pengaturan waktu rilis nilai tidak tersedia melalui FormApp.
 */
function buatDiagnostikFusionFinal() {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const props = PropertiesService.getScriptProperties();
    const idKey = 'PARAMETRA_DIAGNOSTIK_FINAL_V2_QUIZ_FORM_ID';
    const statusKey = 'PARAMETRA_DIAGNOSTIK_FINAL_V2_QUIZ_STATUS';
    const paket = paketDiagnostikFinal_();
    const tersimpan = props.getProperty(idKey);
    let form;
    if (tersimpan) {
      form = FormApp.openById(tersimpan);
      if (props.getProperty(statusKey) === 'SELESAI') {
        tautanDiagnostikFinal_(form);
        return; // Tidak mengubah item, pengaturan, atau respons form yang sudah selesai.
      }
      if (form.getResponses().length > 0) {
        throw new Error('Form parsial sudah memiliki respons. Pembuatan dihentikan agar instrumen yang sedang dipakai tidak berubah. Tinjau form melalui editor.');
      }
    } else {
      // Pemeriksaan gambar sebelum membuat file Google.
      const gambar = gambarDiagnostikFinal_();
      paket.halaman.forEach(function(halaman) {
        halaman.items.forEach(function(q) {
          if (q.gambar && !gambar[q.gambar]) throw new Error('Data gambar belum lengkap: ' + q.gambar);
        });
      });
      form = FormApp.create(paket.judul, false);
      props.setProperty(idKey, form.getId());
      props.setProperty(statusKey, 'MEMBANGUN');
    }

    form.setDescription(paket.deskripsi);
    form.setIsQuiz(true);
    form.setCollectEmail(false);
    form.setPublishingSummary(false);
    form.setShowLinkToRespondAgain(false);
    form.setLimitOneResponsePerUser(false);
    form.setShuffleQuestions(false);
    form.setProgressBar(true);
    form.setConfirmationMessage('Terima kasih. Jawabanmu akan digunakan untuk merencanakan dukungan belajar Autodesk Fusion sesuai kebutuhan siswa.');

    const dataGambar = gambarDiagnostikFinal_();
    paket.halaman.forEach(function(halaman, index) {
      const judul = (index + 1) + '/6 · ' + halaman.judul;
      ambilItemDiagnostikFinal_(form, index === 0 ? 'header' : 'page', judul)
        .setTitle(judul).setHelpText(halaman.petunjuk);
      halaman.items.forEach(function(q) {
        if (q.gambar) {
          const blob = Utilities.newBlob(Utilities.base64Decode(dataGambar[q.gambar]), 'image/png', q.gambar + '.png');
          ambilItemDiagnostikFinal_(form, 'image', 'Gambar untuk ' + q.kode)
            .setTitle('Gambar untuk ' + q.kode).setHelpText(q.alt)
            .setImage(blob).setWidth(640).setAlignment(FormApp.Alignment.CENTER);
        }
        const judulSoal = q.kode ? q.kode + '. ' + q.tanya : q.tanya;
        const item = ambilItemDiagnostikFinal_(form, q.tipe, judulSoal);
        item.setTitle(judulSoal).setHelpText(q.petunjuk || '').setRequired(true);
        if (q.tipe === 'choice') {
          if (Number.isInteger(q.benar)) {
            item.setChoices(q.opsi.map(function(teks, i) {
              return item.createChoice(teks, i === q.benar);
            }));
          } else {
            item.setChoiceValues(q.opsi); // Angket/identitas tidak diberi kunci benar-salah.
          }
        }
        // Hanya B1-B12 dan C1-C2 diberi poin. Item lain memakai default 0.
        // Hindari setPoints(0): panggilan itu ditolak Forms pada pembuatan item baru.
        const poin = Number.isInteger(q.benar) ? 1 : (q.rubrik ? 3 : 0);
        if (poin > 0) item.setPoints(poin);
        if (q.pola) {
          item.setValidation(FormApp.createTextValidation().requireTextMatchesPattern(q.pola)
            .setHelpText(q.validasi).build());
        }
      });
    });
    props.setProperty(statusKey, 'SELESAI');
    Logger.log('Selesai: kuis 6 halaman, 39 isian, 4 gambar. PG otomatis 12 × 1; uraian manual 2 × 3; total 18 poin.');
    Logger.log('WAJIB sebelum publikasi: Setelan > Kuis > Rilis nilai > Nanti, setelah peninjauan manual. Nonaktifkan tampilan jawaban benar kepada responden bila belum akan dibagikan. Guru tetap dapat melihat hasil PG otomatis pada Jawaban > Individual.');
    Logger.log('Form masih draf. Tinjau, uji pratinjau, lalu Publikasikan melalui editor Google Forms.');
    tautanDiagnostikFinal_(form);
  } finally {
    lock.releaseLock();
  }
}

function tautanDiagnostikFinal_(form) {
  Logger.log('EDIT GURU: ' + form.getEditUrl());
  Logger.log('TAUTAN SISWA (aktif setelah dipublikasikan dan akses diatur): ' + form.getPublishedUrl());
}

// Melanjutkan pembuatan parsial berdasarkan judul dan tipe, tanpa menghapus item.
function ambilItemDiagnostikFinal_(form, tipe, judul) {
  const metode = {
    header: ['SECTION_HEADER', 'addSectionHeaderItem', 'asSectionHeaderItem'],
    page: ['PAGE_BREAK', 'addPageBreakItem', 'asPageBreakItem'],
    image: ['IMAGE', 'addImageItem', 'asImageItem'],
    text: ['TEXT', 'addTextItem', 'asTextItem'],
    choice: ['MULTIPLE_CHOICE', 'addMultipleChoiceItem', 'asMultipleChoiceItem'],
    essay: ['PARAGRAPH_TEXT', 'addParagraphTextItem', 'asParagraphTextItem']
  }[tipe];
  if (!metode) throw new Error('Tipe item tidak dikenal: ' + tipe);
  const cocok = form.getItems(FormApp.ItemType[metode[0]]).filter(function(item) {
    return item.getTitle() === judul;
  });
  if (cocok.length > 1) throw new Error('Judul item ganda ditemukan; periksa melalui editor: ' + judul);
  return cocok.length ? cocok[0][metode[2]]() : form[metode[1]]();
}

